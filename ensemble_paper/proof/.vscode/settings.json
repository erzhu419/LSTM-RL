{
  "latex-workshop.latex.tools": [
    {
      "name": "compile-script",
      "command": "bash",
      "args": ["%DIR%/compile.sh"],
      "env": {}
    },
    {
      "name": "xelatex",
      "command": "xelatex.exe",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=/mnt/d/tmp_latex_proof",
        "%DOCFILE%"
      ],
      "env": {}
    },
    {
      "name": "bibtex",
      "command": "bibtex.exe",
      "args": ["/mnt/d/tmp_latex_proof/%DOCFILE%"],
      "env": {}
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "compile.sh (full pipeline)",
      "tools": ["compile-script"]
    },
    {
      "name": "XeLaTeX (single pass, Windows tmp)",
      "tools": ["xelatex"]
    },
    {
      "name": "XeLaTeX → BibTeX → XeLaTeX × 2",
      "tools": ["xelatex", "bibtex", "xelatex", "xelatex"]
    }
  ],
  "latex-workshop.latex.recipe.default": "compile.sh (full pipeline)",
  "latex-workshop.latex.autoBuild.run": "onSave"
}
